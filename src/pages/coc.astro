---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import RowTable from '../components/RowTable.astro';
import { site } from '../data/site';
import { buildBreadcrumbStructuredData } from '../utils/seo';

const breadcrumbs = [
  { label: '首頁', href: '/' },
  { label: '行為準則', href: '/coc/' },
];
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const structuredData = [buildBreadcrumbStructuredData(breadcrumbs, siteUrl)];
---

<BaseLayout
  title="行為準則"
  description="QRACON 2026 行為準則與活動現場回報管道。"
  noindex
  structuredData={structuredData}
>
  <PageHead title="行為準則" status="原文待取得" breadcrumbs={breadcrumbs} />

  <div class="wrap coc-page">
    <RowTable
      caption="回報與協助"
      rows={[
        { label: '回報信箱', value: site.contactEmail },
        { label: '現場協助', value: null },
      ]}
    />
  </div>
</BaseLayout>

<style>
  .coc-page {
    max-width: 48rem;
  }

  :global(main:has(.coc-page)) {
    display: flex;
    flex-direction: column;
  }
  :global(main:has(.coc-page) .page-head) {
    padding-bottom: 0;
  }
  .coc-page {
    flex: 1;
    display: grid;
    align-content: center;
    padding-block: var(--space-7);
  }
  :global(body:has(.coc-page) .site-footer) {
    margin-top: 0;
  }
</style>
