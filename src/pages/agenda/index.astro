---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Timetable from '../../components/agenda/Timetable.astro';
import SideProgram from '../../components/agenda/SideProgram.astro';
import SessionDialog from '../../components/agenda/SessionDialog.astro';
import FlapText from '../../components/FlapText.astro';
import Button from '../../components/Button.astro';
import { sessions, typeLabels, isListed, phases } from '../../data/sessions';
import { site } from '../../data/site';
import { rooms } from '../../data/rooms';
import Icon from '../../components/Icon.astro';
import { buildBreadcrumbStructuredData } from '../../utils/seo';
import type { SessionType } from '../../types/agenda';

const order: SessionType[] = [
  'plenary',
  'keynote',
  'talk',
  'rerun',
  'lightning',
  'workshop',
  'submission',
  'debate',
  'roundtable',
  'exhibit',
  'screening',
  'activity',
];
const present = new Set(sessions.filter(isListed).map((s) => s.type));
const filterTypes = order.filter((t) => present.has(t));
const breadcrumbs = [
  { label: '首頁', href: '/' },
  { label: '議程', href: '/agenda/' },
];
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const structuredData = [buildBreadcrumbStructuredData(breadcrumbs, siteUrl)];
---

<BaseLayout
  title="議程"
  description={`QRACON 2026 議程草案：${site.dateLabel}（${site.weekday}）在${site.venue.org}${site.venue.name}舉行，包含主題演講、量子科技短講、工作坊、量子論壇與海報展示。`}
  structuredData={structuredData}
>
  <link slot="head" rel="expect" href="#timetable" blocking="render" />
  <PageHead
    title="議程"
    status="草案"
    lede={`${site.dateLabel}（${site.weekday}）・${site.venue.org} ${site.venue.name}`}
    breadcrumbs={breadcrumbs}
  />

  <div class="wrap agenda">
    <section class="now-board" data-now-board hidden aria-labelledby="now-title">
      <h2 class="now-board__title" id="now-title">
        現在{' '}
        <time class="now-board__clock" data-now-clock>
          <FlapText text="00:00" size="lg" mode="live" />
        </time>
        <span class="now-board__preview" data-now-preview hidden>
          預覽模式
        </span>
      </h2>
      <div class="now-board__cols">
        <div>
          <h3>
            進行中 <span class="now-board__count" data-now-count hidden></span>
          </h3>
          <ul role="list" data-now-list></ul>
        </div>
        <div>
          <h3>
            下一場 <time class="now-board__next" data-next-time></time>{' '}
            <span class="now-board__count" data-next-count hidden></span>
          </h3>
          <ul role="list" data-next-list></ul>
        </div>
      </div>
    </section>

    <div class="agenda-controls" data-agenda-controls>
      <div class="mobile-controls">
        <label class="mobile-controls__jump">
          <span>跳至時段</span>
          <select data-phase-jump aria-label="跳至議程時段">
            <option value="">選擇時段</option>
            {phases.map((phase) => (
              <option value={phase.id}>
                {phase.from} {phase.label}
              </option>
            ))}
          </select>
        </label>
        <button
          class="mobile-controls__filter"
          type="button"
          data-filter-toggle
          aria-expanded="false"
          aria-controls="agenda-filters"
        >
          篩選：<span data-filter-summary>全部</span>
        </button>
      </div>
      <div class="room-controls" data-room-controls>
        <select data-room-jump aria-label="選擇議程場地">
          {rooms.map((room, index) => (
            <option value={index}>{room.short}</option>
          ))}
        </select>
        <div class="room-controls__arrows">
          <button type="button" data-room-prev aria-label="上一個場地" disabled>
            <Icon name="arrow-left" size={18} />
          </button>
          <span data-room-position aria-live="polite">
            1／{rooms.length}
          </span>
          <button type="button" data-room-next aria-label="下一個場地">
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      </div>
      <nav class="phase-route" aria-label="時段">
        <ol role="list">
          {phases.map((p) => (
            <li>
              <a href={`#${p.id}`}>
                <span class="phase-route__stop">
                  <span class="phase-route__dot" aria-hidden="true" />
                  <span class="phase-route__name">{p.label}</span>
                </span>
                <span class="phase-route__time">{p.from}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="tt-tools" id="agenda-filters" data-tt-tools hidden>
        <fieldset class="tt-tools__types">
          <legend>依類型篩選</legend>
          <div class="tt-tools__chips">
            {filterTypes.map((t) => (
              <button type="button" class="chip" data-filter-type={t} aria-pressed="false">
                {typeLabels[t]}
              </button>
            ))}
          </div>
          <p class="tt-tools__legend">
            <span class="tt-tools__legend-mark" aria-hidden="true" />
            虛線圈＝收藏場次
          </p>
        </fieldset>
        <div class="tt-tools__side">
          <button type="button" class="chip chip--punched" data-filter-punched aria-pressed="false">
            只看已收藏
            <span class="chip__count">
              （<span data-punched-count>0</span>）
            </span>
          </button>
          <button type="button" class="tt-tools__clear" data-filter-clear hidden>
            清除篩選
          </button>
          <p class="tt-tools__count" aria-live="polite" data-tt-count></p>
          <button type="button" class="tt-tools__done" data-filter-done>
            完成篩選
          </button>
        </div>
      </div>
    </div>
    <div class="tt-empty" data-tt-empty hidden role="status">
      <p data-tt-empty-text>沒有符合條件的場次，試試其他類型或清除篩選。</p>
      <button type="button" class="chip" data-filter-reset>
        清除篩選
      </button>
    </div>
    <p class="agenda__scroll-hint">
      <span class="agenda__hint-wide">左右滑動切換場地，點選議程查看詳情；虛線圈可收藏。</span>
      <span class="agenda__hint-narrow">依時間瀏覽，點選議程查看詳情；虛線圈可收藏。</span>
    </p>
    <Timetable />
    <SideProgram />
    <div class="agenda__poster">
      <Button
        href="/2026_QRACON_Agenda.jpg"
        variant="line"
        download="QRACON-2026-Agenda.jpg"
      >
        下載議程海報（JPG）
      </Button>
    </div>
    <SessionDialog />
  </div>
</BaseLayout>

<style>
  .agenda {
    display: grid;
    gap: var(--space-6);
  }

  .agenda__poster {
    display: flex;
    justify-content: flex-start;
  }

  .now-board {
    padding: var(--space-5) var(--space-6);
    background: var(--color-ink);
    color: var(--color-white);
    border-radius: var(--radius-chip);
    --color-focus: var(--color-white);
    --flap-bg: var(--color-ink-raised);
  }

  .now-board__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-xl);
  }

  .now-board__clock,
  .now-board__next {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    letter-spacing: 0.04em;
  }

  .now-board__clock {
    font-size: var(--text-3xl);
  }

  .now-board__preview {
    padding: 0 0.5em;
    border: var(--rule-mid) solid currentColor;
    border-radius: var(--radius-chip);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }

  .now-board__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5) var(--space-7);
    margin-top: var(--space-4);
  }

  .now-board h3 {
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-thin) solid var(--color-white);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
  }
  .now-board__count {
    margin-left: var(--space-2);
    color: var(--color-on-ink-soft);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    letter-spacing: 0;
  }

  .now-board ul {
    margin: 0;
  }

  .now-board :global(li) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
    padding-block: var(--space-2);
    border-bottom: var(--rule-hair) solid var(--color-on-ink-rule);
    color: var(--color-on-ink-soft);
    font-size: var(--text-sm);
  }

  .now-board :global(.now-board__item-title) {
    min-width: 0;
    flex: 1 1 auto;
    color: var(--color-white);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    text-decoration: none;
  }
  .now-board :global(a.now-board__item-title:hover) {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .now-board :global(.now-board__item-meta) {
    flex: 0 1 auto;
    line-height: var(--leading-snug);
    text-align: right;
  }

  .agenda-controls {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .agenda-controls > * {
    min-width: 0;
  }
  .mobile-controls,
  .room-controls {
    display: none;
  }
  .agenda__scroll-hint {
    display: none;
    margin-bottom: -1rem;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
  .agenda__hint-narrow {
    display: none;
  }
  .phase-route ol {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
    margin: 0;
  }
  .phase-route li {
    position: relative;
    flex: 1 1 10rem;
  }
  .phase-route li::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1.75rem - 1px);
    height: 2px;
    background: var(--color-ink);
  }
  .phase-route li:last-child::before {
    display: none;
  }
  .phase-route a {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    grid-template-rows: 2rem auto;
    column-gap: var(--space-2);
    align-items: center;
    padding-block: 0.75rem;
    text-decoration: none;
  }
  .phase-route__stop {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding-right: 0.75rem;
    background: var(--color-paper);
  }
  .phase-route__dot {
    flex: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-white);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .phase-route a:hover .phase-route__dot {
    background: var(--color-ink);
  }
  .phase-route__name {
    font-weight: var(--weight-bold);
  }
  .phase-route a:hover .phase-route__name {
    text-decoration: underline;
  }
  .phase-route__time {
    grid-column: 2;
    grid-row: 2;
    padding-inline: var(--space-2);
    color: var(--color-ink-soft);
    font-family: var(--font-sign);
    font-weight: var(--weight-sign);
    font-size: var(--text-sm);
  }
  .phase-route li[data-empty] .phase-route__dot {
    border-color: var(--color-rule-fine);
    background: var(--color-paper);
  }
  .phase-route li[data-empty] .phase-route__name {
    color: var(--color-ink-soft);
  }
  .phase-route li[data-empty] .phase-route__time {
    color: var(--color-ink-soft);
  }
  .phase-route li[data-empty] a {
    pointer-events: none;
    cursor: default;
  }
  .tt-tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-5) var(--space-6);
    padding: var(--space-5);
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-chip);
    background: var(--color-white);
  }
  .tt-tools__types {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .tt-tools__types legend {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
  }
  .tt-tools__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tt-tools__legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
  }
  .tt-tools__legend-mark {
    width: 1rem;
    height: 1rem;
    flex: none;
    border: var(--rule-mid) dashed currentColor;
    border-radius: 50%;
  }
  .chip {
    min-height: 2.75rem;
    padding: var(--space-1) 0.875rem;
    border: var(--rule-thin) solid var(--color-ink);
    border-radius: var(--radius-chip);
    background: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .chip:hover {
    background: var(--color-paper-deep);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-white);
  }
  .chip__count {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
  }
  .chip__count [data-punched-count] {
    display: inline-block;
  }
  .tt-tools__side {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2);
    padding-left: var(--space-5);
    border-left: var(--rule-hair) solid var(--color-rule-fine);
  }
  .tt-tools__clear {
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-2);
    border: 0;
    background: transparent;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .tt-tools__count {
    grid-column: 1 / -1;
    margin-top: var(--space-1);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }
  .tt-empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--rule-mid) dashed var(--color-ink);
  }
  .tt-tools__done {
    display: none;
  }
  @media (max-width: 71.99rem) {
    :global(html.js) .agenda-controls {
      position: sticky;
      top: 0;
      z-index: 10;
      gap: var(--space-3);
      margin-inline: calc(-1 * var(--gutter));
      padding: var(--space-3) var(--gutter);
      border-bottom: var(--rule-mid) solid var(--color-ink);
      background: var(--color-paper);
    }
    .now-board {
      padding: var(--space-4);
    }
    .now-board__cols {
      gap: var(--space-4);
    }
    .now-board ul {
      display: flex;
      gap: var(--space-2);
      margin-inline: calc(-1 * var(--space-1));
      padding: var(--space-1) var(--space-1) var(--space-2);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
      scrollbar-color: var(--color-on-ink-rule) transparent;
      -webkit-overflow-scrolling: touch;
    }
    .now-board :global(li) {
      flex: 0 0 min(16rem, 82%);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-1);
      padding: var(--space-2) var(--space-3);
      border: var(--rule-hair) solid var(--color-on-ink-rule);
      border-radius: var(--radius-chip);
      scroll-snap-align: start;
    }
    .now-board :global(.now-board__item-meta) {
      text-align: left;
      font-size: var(--text-xs);
    }
    :global(html.js) .mobile-controls {
      display: flex;
      align-items: end;
      gap: var(--space-3);
    }
    @media (min-width: 36rem) {
      :global(html.js) .agenda-controls {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: end;
      }
      :global(html.js) .tt-tools {
        grid-column: 1 / -1;
      }
    }
    :global(html.js) .phase-route {
      display: none;
    }
    :global(html.js) .agenda-controls:not([data-filters-open]) .tt-tools {
      display: none;
    }
    :global(html.js) .room-controls {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      justify-content: space-between;
    }
    .room-controls select {
      min-width: 0;
      flex: 1;
      min-height: 2.75rem;
      border: var(--rule-thin) solid var(--color-ink);
      border-radius: var(--radius-chip);
      background: var(--color-white);
      padding: 0.5rem;
      font-size: 1rem;
      font-weight: var(--weight-bold);
    }
    .room-controls__arrows {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .room-controls__arrows button {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: var(--rule-thin) solid var(--color-ink);
      border-radius: var(--radius-chip);
      background: var(--color-white);
    }
    .room-controls__arrows button:disabled {
      opacity: 0.3;
      cursor: default;
    }
    .room-controls__arrows span {
      min-width: 2.75rem;
      text-align: center;
      font-family: var(--font-sign);
      font-weight: var(--weight-sign-heavy);
      font-size: var(--text-sm);
    }
    .agenda__scroll-hint {
      display: block;
    }
    .mobile-controls__jump {
      display: grid;
      gap: var(--space-1);
      flex: 1;
      min-width: 0;
      font-size: var(--text-xs);
      font-weight: var(--weight-bold);
    }
    .mobile-controls__jump select {
      width: 100%;
      min-height: 2.75rem;
      padding: var(--space-2);
      border: var(--rule-thin) solid var(--color-ink);
      border-radius: var(--radius-chip);
      background: var(--color-white);
      font-size: 1rem;
    }
    .mobile-controls__filter {
      min-height: 2.75rem;
      padding: var(--space-2) var(--space-3);
      border: var(--rule-thin) solid var(--color-ink);
      border-radius: var(--radius-chip);
      background: var(--color-white);
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      white-space: nowrap;
    }
    .mobile-controls__filter span {
      margin-left: var(--space-1);
      font-size: var(--text-xs);
      font-weight: var(--weight-regular);
    }
    .mobile-controls__filter[aria-expanded='true'] {
      background: var(--color-ink);
      color: var(--color-white);
    }
    .tt-tools {
      grid-template-columns: 1fr;
      max-height: min(26rem, max(8rem, calc(100svh - 11rem)));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-4);
      gap: var(--space-4);
    }
    .tt-tools__legend {
      display: none;
    }
    .tt-tools__side {
      padding: var(--space-3) 0 0;
      border-left: 0;
      border-top: var(--rule-hair) solid var(--color-rule-fine);
      grid-template-columns: auto 1fr;
    }
    .tt-tools__clear {
      justify-self: end;
    }
    .tt-tools__count {
      text-align: left;
    }
    .tt-tools__done {
      display: block;
      grid-column: 1 / -1;
      min-height: 2.75rem;
      border: var(--rule-thin) solid var(--color-ink);
      border-radius: var(--radius-chip);
      background: var(--color-ink);
      color: var(--color-white);
      font-size: 1rem;
      font-weight: var(--weight-bold);
    }
    .phase-route ol {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
  @media (max-width: 71.99rem) and (min-width: 36rem) and (max-height: 32rem) {
    :global(html.js) .agenda-controls {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-2) var(--space-3);
      padding-block: var(--space-2);
    }
    .room-controls,
    .mobile-controls {
      min-width: 0;
    }
    .room-controls__arrows {
      gap: 0.25rem;
    }
    .room-controls__arrows span {
      min-width: 2rem;
    }
    .tt-tools {
      grid-column: 1 / -1;
      max-height: calc(100svh - 6rem);
    }
  }
  @media (max-width: 22rem) {
    .room-controls {
      gap: var(--space-2);
    }
    .room-controls__arrows {
      gap: 0.25rem;
    }
    .room-controls__arrows span {
      min-width: 2rem;
    }
    .tt-tools__types .chip {
      padding-inline: 0.6rem;
    }
  }
  @media (max-width: 47.99rem) {
    :global(html.js) .agenda-controls {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(html.js) .room-controls {
      display: none;
    }
    .agenda__hint-wide {
      display: none;
    }
    .agenda__hint-narrow {
      display: inline;
    }
  }
</style>

<script>
  import { initAgenda } from '../../scripts/agenda';
  initAgenda();
</script>
