---
import { Image } from 'astro:assets';
import placeholderAvatar from '../assets/team/qracon-placeholder-avatar.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { teamGroups, teamHeadcount, photoOf } from '../data/team';
import { buildBreadcrumbStructuredData } from '../utils/seo';

const breadcrumbs = [
  { label: '首頁', href: '/' },
  { label: '籌備團隊', href: '/team/' },
];
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const structuredData = [buildBreadcrumbStructuredData(breadcrumbs, siteUrl)];
---

<BaseLayout
  title="籌備團隊"
  description={`QRACON 2026 籌備團隊名單：召組、行銷組、財務組、設計組、議程組、攝影組與機動組，共 ${teamGroups.length} 組 ${teamHeadcount} 人。`}
  structuredData={structuredData}
>
  <PageHead
    title="籌備團隊"
    status={`${teamHeadcount} 人`}
    breadcrumbs={breadcrumbs}
  />

  <nav class="wrap team__index" aria-label="組別">
    <ul role="list">
      {
        teamGroups.map((group) => (
          <li>
            <a href={`#group-${group.id}`} aria-label={`${group.name}，${group.members.length} 人`}>
              {group.name}
              <span class="team__index-count" aria-hidden="true">{group.members.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="wrap team">
    <ol class="team__groups" role="list">
      {
        teamGroups.map((group) => (
          <li class="team__group" id={`group-${group.id}`}>
            <div class="team__head">
              <h2 class="team__name">{group.name}</h2>
              <p class="team__en">{group.en}</p>
              <p class="team__count">
                {group.members.length}
                <span class="team__count-unit"> 人</span>
              </p>
            </div>
            <p class="team__blurb">{group.blurb}</p>
            <ul class="team__members" role="list">
              {group.members.map((member) => {
                const photo = photoOf(member) ?? placeholderAvatar;
                return (
                  <li class="crew">
                    <Image
                      class="crew__photo"
                      src={photo}
                      alt=""
                      widths={[160, 240, 320, 400]}
                      sizes="(min-width: 48rem) 7.2rem, 29vw"
                      format="webp"
                      loading={group.id === 'core' ? 'eager' : 'lazy'}
                    />
                    <p class="crew__label">{member}</p>
                  </li>
                );
              })}
            </ul>
          </li>
        ))
      }
    </ol>

  </div>
</BaseLayout>

<style>
  .team__index ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
  }

  .team__index a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: var(--space-1) var(--space-3);
    border: var(--rule-mid) solid var(--color-ink);
    border-radius: var(--radius-chip);
    background: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .team__index a:hover,
  .team__index a:focus-visible {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .team__index-count {
    color: var(--color-ink-soft);
    font-family: var(--font-sign);
    font-weight: var(--weight-sign-heavy);
    font-variant-numeric: tabular-nums;
  }

  .team__index a:hover .team__index-count,
  .team__index a:focus-visible .team__index-count {
    color: inherit;
  }

  .team__groups {
    border-top: var(--rule-heavy) solid var(--color-ink);
  }

  .team__group {
    padding-block: var(--space-5);
    border-bottom: var(--rule-hair) solid var(--color-ink);
  }

  .team__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    margin-bottom: var(--space-2);
  }

  .team__name {
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    letter-spacing: 0.06em;
  }

  .team__en,
  .team__count {
    color: var(--color-ink-soft);
    font-family: var(--font-sign);
    font-size: var(--text-xs);
    font-weight: var(--weight-sign-heavy);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  .team__count-unit {
    font-family: var(--font-sans);
    font-weight: var(--weight-bold);
  }

  .team__en {
    font-family: var(--font-sign);
    font-weight: var(--weight-sign);
  }

  .team__blurb {
    max-width: var(--measure);
    margin-bottom: var(--space-4);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .team__members {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: var(--space-2);
  }

  .crew {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    aspect-ratio: 1 / 1.28;
    border: var(--rule-thin) solid var(--color-ink);
    background: var(--color-white);
    overflow: hidden;
  }

  /* 頭像來源已經是 1:1，這裡不再裁第二次。 */
  .crew__photo {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .crew__label {
    display: grid;
    place-items: center;
    min-height: 1.6rem;
    padding: 0 var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.02em;
    text-align: center;
    line-height: var(--leading-snug);
  }

  .crew__label {
    border-top: var(--rule-hair) solid var(--color-ink);
  }

  @media (max-width: 47.99rem) {
    .team__head {
      gap: 0 var(--space-2);
      margin-bottom: var(--space-3);
    }

    .team__members {
      grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    }
  }
</style>
