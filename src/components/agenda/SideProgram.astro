---
import { sideVenues } from '../../data/side-program';
import { eventDateTime } from '../../utils/timetable';
import { toMinutes } from '../../utils/time';
import Words from '../Words.astro';

const venues = sideVenues.map((venue, index) => ({
  ...venue,
  headingId: `side-venue-${index + 1}`,
  programs: venue.programs?.map((row) => ({
    ...row,
    startDateTime: row.from ? eventDateTime(toMinutes(row.from)) : undefined,
    endDateTime: row.to ? eventDateTime(toMinutes(row.to)) : undefined,
  })),
}));
const venueColumns = [venues.slice(0, 2), venues.slice(2)];
---

<section class="side-program" id="side-program" aria-labelledby="side-program-title">
  <h2 class="side-program__title" id="side-program-title">其他場地與活動</h2>

  <div class="side-program__venues">
    {venueColumns.map((column) => (
      <div class="side-program__column">
        {column.map((venue) => (
          <section class="side-venue" aria-labelledby={venue.headingId}>
            <h3 class="side-venue__title" id={venue.headingId}>
              <Words text={venue.name} />
            </h3>
            <ul class="side-venue__list" role="list">
              {venue.programs?.map((row) => (
                <li class="side-entry" role="listitem">
                  {row.from && (
                    <p class="side-entry__time">
                      <time datetime={row.startDateTime}>{row.from}</time>
                      {row.to && <>–<time datetime={row.endDateTime}>{row.to}</time></>}
                    </p>
                  )}
                  <div class="side-entry__content">
                    <p class="side-entry__name"><Words text={row.title} /></p>
                    {row.detail && <p class="side-entry__detail"><Words text={row.detail} /></p>}
                    {row.note && <p class="side-entry__note"><Words text={row.note} /></p>}
                  </div>
                </li>
              ))}
              {venue.spaces?.map((space) => (
                <li class="side-entry side-entry--space" role="listitem">
                  <div class="side-entry__content">
                    <p class="side-entry__name"><Words text={space.title} /></p>
                    {space.detail && <p class="side-entry__detail"><Words text={space.detail} /></p>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .side-program {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    padding-top: var(--space-5);
    border-top: var(--rule-heavy) solid var(--color-ink);
  }

  .side-program__title {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .side-program__venues {
    display: grid;
    gap: var(--space-4);
  }

  .side-program__column {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    min-width: 0;
  }

  @media (min-width: 48rem) {
    .side-program__venues {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .side-venue {
    min-width: 0;
    border-bottom: var(--rule-thin) solid var(--color-ink);
  }

  .side-venue__title {
    padding: var(--space-2) var(--space-3);
    background: var(--color-ink);
    color: var(--color-white);
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
  }

  .side-venue__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-entry {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.26fr) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    min-width: 0;
    padding: var(--space-3);
    border-top: var(--rule-hair) solid var(--color-rule-fine);
  }

  .side-entry__time {
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-sign);
    font-size: var(--text-md);
    font-weight: var(--weight-sign-heavy);
    letter-spacing: var(--tracking-sign);
  }

  .side-entry__content {
    min-width: 0;
  }

  .side-entry__name {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
  }

  .side-entry__detail,
  .side-entry__note {
    margin: var(--space-1) 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .side-entry--space {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 47.99rem) {
    .side-entry,
    .side-entry--space {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
