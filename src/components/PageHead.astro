---
import Stamp from './Stamp.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { BreadcrumbItem } from '../utils/seo';

interface Props {
  title: string;
  lede?: string;
  status?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, lede, status, breadcrumbs } = Astro.props;
---

<header class="page-head wrap">
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
  <div class="page-head__heading">
    <h1 class="page-head__title">
      <span>{title}</span>
    </h1>
    {status && <Stamp label={status} size="md" class="page-head__stamp" />}
  </div>
  {lede && <p class="page-head__lede">{lede}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-7);
  }

  .page-head__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .page-head__title {
    font-size: var(--text-display);
    letter-spacing: 0.06em;
    line-height: 1.05;
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-head__heading :global(.page-head__stamp) {
      animation: stamp-land var(--dur-base) var(--ease-out) 180ms backwards;
    }

    @keyframes stamp-land {
      from {
        opacity: 0;
        scale: 1.5;
      }
    }
  }

  .page-head__lede {
    max-width: var(--measure);
    margin-top: var(--space-5);
    font-size: var(--text-lg);
  }

  @media (max-width: 47.99rem) {
    .page-head {
      padding-block: var(--space-7) var(--space-6);
    }
  }
</style>
